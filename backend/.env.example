# ========================================================
# WalletPro Backend - Environment Configuration
# ========================================================

# Port for local server (Vercel assigns PORT automatically)
PORT=3000

# PostgreSQL Connection String (e.g. Supabase, Neon, or local Postgres)
DATABASE_URL="postgresql://postgres:yourpassword@db.xxxxxx.supabase.co:5432/postgres?sslmode=require"

# --------------------------------------------------------
# Personal / Single-User Mode (Optimized for Personal Use)
# --------------------------------------------------------
# When enabled, automatically provisions and resolves to your personal user account
SINGLE_USER_MODE=true
PERSONAL_USER_ID=personal-user-001

# Optional API Secret Key to protect your backend endpoints
# Pass this in the 'x-api-key' header or 'Bearer <key>' from your mobile app
API_SECRET_KEY=my_secure_walletpro_secret_123

# Optional: You can put your BudgetBakers Wallet REST API token directly here
# (or provide it via the app UI Settings)
WALLET_API_TOKEN=your_budgetbakers_token_from_web_settings

# BudgetBakers Wallet REST API Base URL
WALLET_API_BASE_URL=https://rest.budgetbakers.com/wallet

# --------------------------------------------------------
# Vercel Cron Secret (Optional)
# --------------------------------------------------------
# Secures the /api/cron/nav and /api/cron/cleanup endpoints
CRON_SECRET=my_cron_secret_key

# --------------------------------------------------------
# Optional Integrations
# --------------------------------------------------------
# Google Gemini API Key for smart category classification (from ai.google.dev)
GEMINI_API_KEY=

# Google OAuth (for Gmail transaction email sync - personal testing mode)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
